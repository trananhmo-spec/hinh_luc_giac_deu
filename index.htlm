<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tham tu khong gian: Bi mat Luc giac deu</title>
    <style>
        :root {
            --primary: #0284c7;
            --primary-hover: #0369a1;
            --bg-color: #f0f9ff;
            --card-bg: #ffffff;
            --text-color: #1e293b;
            --accent: #10b981;
        }

        body {
            font-family: Arial, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-color);
            margin: 0;
            padding: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
        }

        .game-container {
            width: 90%;
            max-width: 800px;
            background: var(--card-bg);
            border-radius: 16px;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }

        .screen {
            padding: 30px;
            display: none;
            flex-direction: column;
            align-items: center;
            text-align: center;
        }

        .screen.active {
            display: flex;
        }

        h1 { color: var(--primary); margin-bottom: 10px; }
        h2 { color: var(--text-color); margin-bottom: 20px; }
        p { font-size: 1.1rem; line-height: 1.6; margin-bottom: 20px; }

        .btn {
            background-color: var(--primary);
            color: white;
            border: none;
            padding: 12px 24px;
            font-size: 1rem;
            font-weight: bold;
            border-radius: 8px;
            cursor: pointer;
            box-shadow: 0 4px 6px rgba(2, 132, 199, 0.2);
            margin-top: 15px;
        }

        .btn:hover {
            background-color: var(--primary-hover);
        }

        /* Màn hình 1 */
        .puzzle-area {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 30px;
            margin-bottom: 20px;
            flex-wrap: wrap;
        }

        .triangle-pieces {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 10px;
            background: #e0f2fe;
            padding: 15px;
            border-radius: 12px;
            border: 2px dashed var(--primary);
        }

        .piece {
            background: #bae6fd;
            border: 2px solid #0284c7;
            padding: 10px;
            border-radius: 6px;
            cursor: pointer;
            font-weight: bold;
            font-size: 0.9rem;
        }
        .piece:hover { background: #7dd3fc; }
        .piece.used { opacity: 0.3; pointer-events: none; }

        .hex-target {
            width: 200px;
            height: 180px;
            background: #f8fafc;
            border: 2px solid #cbd5e1;
            border-radius: 12px;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        /* Màn hình 2 */
        .lab-container {
            display: flex;
            width: 100%;
            gap: 20px;
            text-align: left;
        }

        .hex-workspace {
            flex: 1;
            position: relative;
            height: 280px;
            background: #f8fafc;
            border: 2px solid #e2e8f0;
            border-radius: 12px;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .hex-shape {
            width: 140px;
            height: 140px;
            background: rgba(2, 132, 199, 0.08);
            border: 3px solid var(--primary);
            position: relative;
            display: flex;
            justify-content: center;
            align-items: center;
            font-weight: bold;
            color: #0284c7;
        }

        .diagonal-line {
            position: absolute;
            background: #f59e0b;
            display: none;
        }
        #d-ad { width: 3px; height: 140px; top: 0; left: 50%; }
        #d-be { width: 140px; height: 3px; top: 50%; left: 0; }
        #d-cf { width: 140px; height: 3px; top: 50%; left: 0; transform: rotate(60deg); }
        #d-cf2 { width: 140px; height: 3px; top: 50%; left: 0; transform: rotate(-60deg); }

        .controls-panel {
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .observation-box {
            background: #f0fdf4;
            border: 1px solid #bbf7d0;
            padding: 15px;
            border-radius: 8px;
        }

        .observation-box h3 { margin-top: 0; color: #047857; font-size: 1.1rem; }
        .observation-box ul { padding-left: 20px; margin: 0; }
        .observation-box li { margin-bottom: 8px; font-size: 0.95rem; color: #166534; }

        .tool-buttons { display: flex; flex-direction: column; gap: 8px; }
        .tool-btn { background-color: #0ea5e9; padding: 10px; font-size: 0.9rem; margin: 0; color: white; border: none; border-radius: 6px; cursor: pointer; }
        .tool-btn:hover { background-color: #0284c7; }
    </style>
</head>
<body>

<div class="game-container">
    <!-- MÀN HÌNH CHÀO MỪNG -->
    <div id="screen-welcome" class="screen active">
        <h1>Thám tử không gian</h1>
        <h2>Khám phá Hình lục giác đều</h2>
        <p>Cùng ghép tam giác đều thành hình lục giác (HD5) và khám phá các đường chéo chính (HD6)!</p>
        <button class="btn" onclick="goToScreen('screen-hd5')">Bắt đầu thám hiểm</button>
    </div>

    <!-- MÀN HÌNH 1: HD5 -->
    <div id="screen-hd5" class="screen">
        <h2>Nhiệm vụ 1: Lắp ráp hình (HD5)</h2>
        <p>Nhấp lần lượt vào <strong>6 hình tam giác</strong> bên trái để lắp đầy khung bên phải!</p>
        
        <div class="puzzle-area">
            <div class="triangle-pieces">
                <div class="piece" onclick="clickPiece(this)">Tam giác 1</div>
                <div class="piece" onclick="clickPiece(this)">Tam giác 2</div>
                <div class="piece" onclick="clickPiece(this)">Tam giác 3</div>
                <div class="piece" onclick="clickPiece(this)">Tam giác 4</div>
                <div class="piece" onclick="clickPiece(this)">Tam giác 5</div>
                <div class="piece" onclick="clickPiece(this)">Tam giác 6</div>
            </div>
            
            <div class="hex-target" id="hex-target-box">
                <span id="target-text" style="font-weight: bold; color: #64748b;">Khung trống (0/6)</span>
            </div>
        </div>

        <button id="btn-next-hd6" class="btn" style="display: none;" onclick="goToScreen('screen-hd6')">Tiếp tục sang phòng phân tích ➔</button>
    </div>

    <!-- MÀN HÌNH 2: HD6 -->
    <div id="screen-hd6" class="screen">
        <h2>Nhiệm vụ 2: Phòng phân tích ABCDEF (HD6)</h2>
        <p>Kiểm tra các thuộc tính cạnh, góc và đường chéo chính.</p>

        <div class="lab-container">
            <div class="hex-workspace">
                <div class="hex-shape">
                    ABCDEF
                    <div id="d-ad" class="diagonal-line"></div>
                    <div id="d-be" class="diagonal-line"></div>
                    <div id="d-cf" class="diagonal-line"></div>
                    <div id="d-cf2" class="diagonal-line"></div>
                </div>
            </div>

            <div class="controls-panel">
                <div class="tool-buttons">
                    <button class="tool-btn" onclick="checkHexEdges()">📏 Kiểm tra Sáu cạnh</button>
                    <button class="tool-btn" onclick="checkHexAngles()">📐 Kiểm tra Sáu góc (120 độ)</button>
                    <button class="tool-btn" onclick="checkHexDiagonals()">❌ Kẻ Đường chéo chính</button>
                </div>

                <div class="observation-box">
                    <h3>Sổ tay nhận xét:</h3>
                    <ul id="observation-list">
                        <li>Hãy chọn các nút phân tích phía trên!</li>
                    </ul>
                </div>
            </div>
        </div>

        <button id="btn-finish" class="btn" style="display: none;" onclick="goToScreen('screen-end')">Hoàn thành bài học 🎉</button>
    </div>

    <!-- MÀN HÌNH 3: KẾT THÚC -->
    <div id="screen-end" class="screen">
        <h1>Chúc mừng bạn đã hoàn thành!</h1>
        <p>Em đã nắm vững các nội dung trọng tâm:</p>
        <div style="background: #f0fdf4; border: 1px solid #bbf7d0; padding: 15px; border-radius: 8px; text-align: left; margin-bottom: 20px; width: 85%;">
            <strong>Nhận xét chung về Hình lục giác đều:</strong>
            <ul>
                <li>Sáu cạnh bằng nhau.</li>
                <li>Sáu góc bằng nhau, mỗi góc bằng 120°.</li>
                <li>Ba đường chéo chính bằng nhau.</li>
            </ul>
        </div>
        <button class="btn" onclick="location.reload()">Chơi lại từ đầu</button>
    </div>
</div>

<script>
    function goToScreen(screenId) {
        document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
        document.getElementById(screenId).classList.add('active');
    }

    let assembledCount = 0;
    function clickPiece(element) {
        element.classList.add('used');
        assembledCount++;
        document.getElementById('target-text').innerText = `Đã ghép: ${assembledCount}/6`;
        
        if (assembledCount === 6) {
            document.getElementById('hex-target-box').style.background = '#d1fae5';
            document.getElementById('hex-target-box').style.borderColor = '#10b981';
            document.getElementById('target-text').innerText = 'Hoàn thành lục giác!';
            document.getElementById('target-text').style.color = '#047857';
            document.getElementById('btn-next-hd6').style.display = 'block';
        }
    }

    let checkedEdges = false, checkedAngles = false, checkedDiagonals = false;

    function updateObservationList() {
        const list = document.getElementById('observation-list');
        list.innerHTML = '';
        if (checkedEdges) list.innerHTML += '<li>✓ Sáu cạnh bằng nhau.</li>';
        if (checkedAngles) list.innerHTML += '<li>✓ Sáu góc bằng nhau (120 độ).</li>';
        if (checkedDiagonals) list.innerHTML += '<li>✓ Ba đường chéo chính bằng nhau.</li>';
        if (!checkedEdges && !checkedAngles && !checkedDiagonals) list.innerHTML = '<li>Hãy chọn các nút phân tích phía trên!</li>';
        if (checkedEdges && checkedAngles && checkedDiagonals) document.getElementById('btn-finish').style.display = 'block';
    }

    function checkHexEdges() {
        checkedEdges = true;
        alert('Kết quả: Sáu cạnh bằng nhau!');
        updateObservationList();
    }

    function checkHexAngles() {
        checkedAngles = true;
        alert('Kết quả: Sáu góc bằng nhau và mỗi góc bằng 120 độ!');
        updateObservationList();
    }

    function checkHexDiagonals() {
        checkedDiagonals = true;
        document.getElementById('d-ad').style.display = 'block';
        document.getElementById('d-be').style.display = 'block';
        document.getElementById('d-cf').style.display = 'block';
        document.getElementById('d-cf2').style.display = 'block';
        alert('Kết quả: Đã kẻ các đường chéo chính bằng nhau!');
        updateObservationList();
    }
</script>

</body>
</html>
